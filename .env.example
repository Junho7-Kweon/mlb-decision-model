# NWS requests should identify this application and provide a contact address.
# Do not commit private credentials or personal contact details in a real .env file.
NWS_USER_AGENT=mlb-decision-model/contact@example.com

# Issued after applying for data set 15107776 at data.go.kr.
DATA_GO_KR_SERVICE_KEY=

